# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080

# ── URLs ─────────────────────────────────────────────────────────────────────
# Public URL of this API. Better Auth builds callback/reset links from it.
API_BASE_URL=http://localhost:8080
# Frontend origin. Used in invitation and password-reset emails.
APP_BASE_URL=http://localhost:3000
# Browser origins allowed to call this API with credentials, comma separated.
# Only localhost is allowed by default: staging and production hostnames are
# siblings under ragenta.cloud, so no wildcard can cover one without the other.
TRUSTED_ORIGINS=

# ── Auth ─────────────────────────────────────────────────────────────────────
# Min 32 chars. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Leave empty. There is no cookie Domain that spans one environment's hostnames
# without also spanning the other's — both are siblings under ragenta.cloud.
AUTH_COOKIE_DOMAIN=
# Optional Google sign-in. Both must be set to enable it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Data stores ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ragenta:ragenta@localhost:5432/ragenta
REDIS_URL=redis://localhost:6379

# Counters in front of sign-in, chat sends, agent runs and speech. Set to false
# only to switch a misfiring limiter off in a hurry — Redis being unreachable
# already lets requests through on its own.
RATE_LIMIT_ENABLED=true

# How long a recorded provider failure is kept. 0 disables the sweep.
PROVIDER_ERROR_RETENTION_DAYS=30

# Whether a workspace may point a data source at a private, loopback or
# link-local address. Off on any deployment more than one customer shares:
# on, a connection string is a way to reach this deployment's own network.
DATASOURCE_ALLOW_PRIVATE_HOSTS=false

# Vector store. Unset means knowledge-base and chat endpoints answer 503 rather
# than accepting an upload that could never be indexed.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# S3-compatible object storage for uploaded documents. All three of endpoint,
# access key and secret key are required to enable it; docker-compose.yml starts
# MinIO with these defaults.
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=ragenta
STORAGE_SECRET_KEY=ragenta-dev-secret
STORAGE_BUCKET=ragenta-documents
STORAGE_REGION=us-east-1

# ── Secrets at rest ──────────────────────────────────────────────────────────
# 32 bytes of base64. Encrypts the provider API keys stored through the admin
# API. Without it the platform still runs on the keys below, but storing one
# through the console is refused — writing a secret in the clear because a key
# was missing is not the safer fallback.
#   openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=

# ── AI providers ─────────────────────────────────────────────────────────────
# Ragenta pays for inference and customers spend credits, so these are server
# secrets. A provider with no key here is hidden from every model picker.
#
# These are now the FALLBACK. The admin console stores provider keys encrypted
# in `provider_credential`, and a database row wins over the value here — that
# is the one an operator can rotate without a redeploy. Keep these for a
# deployment that has no SECRETS_ENCRYPTION_KEY, or as the bootstrap key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── Stripe (optional — both key and webhook secret required to enable payments)
# Without both, checkout, the billing portal and auto-reload return
# "Payments are not enabled on this deployment." and the scan job no-ops.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring prices (per seat for pro, flat for team)
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
# One-off top-up packs: 1M/$39, 5M/$175, 15M/$450
STRIPE_PRICE_TOPUP_1M=
STRIPE_PRICE_TOPUP_5M=
STRIPE_PRICE_TOPUP_15M=

# ── Speech (optional — transcription and synthesis configured separately) ────
# Both halves speak the OpenAI audio API shape, so the same variables point at
# either the hosted service or a self-hosted server:
#   hosted     SPEECH_STT_BASE_URL=https://api.openai.com/v1, model whisper-1
#   speaches   SPEECH_STT_BASE_URL=http://speaches:8000/v1, model Systran/faster-whisper-large-v3
# A self-hosted server that ignores authentication still needs a value in the
# key — put anything, as with Ollama. All three must be set or STT stays off.
SPEECH_STT_BASE_URL=
SPEECH_STT_API_KEY=
SPEECH_STT_MODEL=

# Synthesis. OpenAI has no Vietnamese voice, so a deployment serving Vietnamese
# points these at a sidecar publishing the same shape in front of VieNeu-TTS.
# The voice is required with the rest: voice ids are server-specific and there
# is no default that is right for both.
SPEECH_TTS_BASE_URL=
SPEECH_TTS_API_KEY=
SPEECH_TTS_MODEL=
SPEECH_TTS_VOICE=

# ── Browser service (optional — the browser_read agent tool) ──────────────
# A remote browser, spoken to in the browserless REST shape (POST /content,
# POST /scrape). Remote rather than in-process: Chromium in the API image would
# multiply its size and memory floor for a tool that is the fallback after an
# API. Unset means browser_read refuses and says so.
#
#   compose    BROWSER_BASE_URL=http://browserless:3000
#
# SECURITY — read before deploying this. The URL the agent opens comes from the
# model, which may have read it out of a document somebody uploaded. Ragenta
# checks the address ranges before calling, but the browser service resolves the
# hostname itself, so that check narrows the hole and does not close it. Run the
# browser service on a network from which it CANNOT reach Postgres, Redis, MinIO,
# Qdrant or a cloud metadata endpoint. That network is the real boundary.
#
# The token is optional only because a container on the compose network may run
# without one. Anything reachable beyond that network must set it.
BROWSER_BASE_URL=
BROWSER_TOKEN=

# ── Email (optional in development — unset SMTP_HOST logs mails instead) ─────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@ragenta.cloud
SMTP_FROM_NAME=Ragenta

# ── Docs ─────────────────────────────────────────────────────────────────────
# Serve /v1/docs and /v1/openapi.json. Defaults to on outside production.
DOCS_ENABLED=true

# ── Platform admin ───────────────────────────────────────────────────────────
# Comma-separated user ids that always pass the admin gate, regardless of role.
ADMIN_USER_IDS=
