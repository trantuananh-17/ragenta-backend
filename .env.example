# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080

# ── URLs ─────────────────────────────────────────────────────────────────────
# Public URL of this API. Better Auth builds callback/reset links from it.
API_BASE_URL=http://localhost:8080
# Frontend origin. Used in invitation and password-reset emails.
APP_BASE_URL=http://localhost:3000
# Extra CORS origins, comma separated. localhost and *.ragenta.* are allowed by default.
TRUSTED_ORIGINS=

# ── Auth ─────────────────────────────────────────────────────────────────────
# Min 32 chars. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Set in staging/production to share the session cookie across subdomains
# (e.g. ragenta.com). Leave empty for localhost.
AUTH_COOKIE_DOMAIN=
# Optional Google sign-in. Both must be set to enable it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Data stores ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ragenta:ragenta@localhost:5432/ragenta
REDIS_URL=redis://localhost:6379

# ── Email (optional in development — unset SMTP_HOST logs mails instead) ─────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@ragenta.com
SMTP_FROM_NAME=Ragenta

# ── Docs ─────────────────────────────────────────────────────────────────────
# Serve /v1/docs and /v1/openapi.json. Defaults to on outside production.
DOCS_ENABLED=true

# ── Platform admin ───────────────────────────────────────────────────────────
# Comma-separated user ids that always pass the admin gate, regardless of role.
ADMIN_USER_IDS=
